# --- required everywhere ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# at least 32 random chars: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# --- required when NODE_ENV=production (the server refuses to start without them) ---
NODE_ENV=production
# comma separated frontend origin(s), no trailing slash
CORS_ORIGINS=https://hrms.example.com
# used in password-reset and welcome e-mail links
FRONTEND_LOGIN_URL=https://hrms.example.com

# --- optional ---
PORT=5000
# number of reverse proxies in front of the app (1 for Render/Railway/nginx)
TRUST_PROXY=1
# DISABLE_DAILY_JOBS=true     # local testing only
# DISABLE_RATE_LIMIT=true     # local testing only (rejected in production)